{
  "plepa-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "if exist ..\\.venv\\Scripts\\python.exe (..\\.venv\\Scripts\\python.exe hooks\\plepa_guard.py) else (python hooks\\plepa_guard.py)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
